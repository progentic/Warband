package replay_test

import "core:encoding/hex"
import "core:encoding/endian"
import "core:crypto/sha2"
import c "../../../src/custody"
import e "../../../src/domain/events"
import r "../../../src/replay"

// PR #94 x64-review fault inventory fb5c02e3…: actual initial REJECTION and GENESIS,
// and its published sequence-zero head. Later PENDING/COMMITTED frames are test fixtures.
RealPrefix :: ""
RealHead :: "57424844010001010101010101010101010101010101010000000000000000000000000000004108f68b6628686c9fe94edc2de4870eeff827522ac180a58721a75bc097cd18cc9f25aed08e7fa82c4f150c589a3aba78868ac849b32792135dc04a4b6aae1a9275718ef3c71bb8250061faac9f57c6b86dc3f8fa48adf0994034cae0b70ecb"

// ADR-0005 TaskCreated and independently packed marker bodies, with the same task/run.
ReplayBodies :: [8]string{
	"",
	"",
	"",
	"5742455602000d0001010101010101010101010101010101010000000000000004000000000000000c00000000000000020001005100000001010101010101010101010101010101010000000000000003000000000000000808080808080808080808080808080800000000000000008c4a5d05000000000109090909090909090909090909090909",
	"",
	"5742455602000f0001010101010101010101010101010101010000000000000006000000000000000e00000000000000070001005c00000001010101010101010101010101010101010000000000000005000000000000000a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a020101020300000000000000ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
	"",
	"",
}
FinalMarkerHead :: "2a7b228ff770fab2e26583c127366359963e419bbfc761194b20118132bf6c59"
EmptyBody2 :: ""
EmptyBody3 :: ""
EmptyBody5 :: ""
EmptyBody6 :: "5742455602000f0001010101010101010101010101010101010000000000000006000000000000000e00000000000000070001005c00000001010101010101010101010101010101010000000000000005000000000000000a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a020101020000000000000000e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
RevocationBody :: "574245560100090001010101010101010101010101010101010000000000000008000000000000001000000000000000020001003a00000001010101010101010101010101010101010000000000000004000000000000000808080808080808080808080808080802000000000000000c00"
DispositionBody :: "5742455601000a0001010101010101010101010101010101010000000000000008000000000000001000000000000000050001002b00000001010101010101010101010101010101010000000000000005000000000000000200000000000000010a00"
NoopProposal :: "574245560100020001010101010101010101010101010101010000000000000002000000000000000a00000000000000010001004b000000111111111111111111111111111111112222222222222222222222222222222204040404040404040404040404040404010000000000000001000000000000000100000000000001000100"
NoopPermit :: "574245560100030001010101010101010101010101010101010000000000000003000000000000000b0000000000000002000100520000000101010101010101010101010101010101000000000000000200000000000000000000000000000001080808080808080808080808080808088c4a5d05000000000109090909090909090909090909090909"

MarkerFixture :: struct { data: [12][320]u8, lengths: [12]int }

set_body :: proc(f: ^MarkerFixture,i: int,text: string) {
	b,ok := hex.decode(transmute([]u8)text)
	defer delete(b)
	assert(ok && len(b)+32<=len(f.data[i]))
	copy(f.data[i][:],b)
	f.lengths[i] = len(b)
}

marker_fixture :: proc() -> (f: MarkerFixture) {
	for text,i in ReplayBodies { set_body(&f,i,text) }
	return
}

fixture_digest :: proc(b: []u8, domain: string = "warband.event.v1\x00") -> (d: [32]u8) {
	ctx: sha2.Context_256
	sha2.init_256(&ctx)
	sha2.update(&ctx,transmute([]u8)domain)
	sha2.update(&ctx,b)
	sha2.final(&ctx,d[:])
	return
}

sync_observation_digest :: proc(f: ^MarkerFixture) {
	d := fixture_digest(f.data[5][:f.lengths[5]])
	copy(f.data[6][120:152],d[:])
}

// Reseal every changed body and validate its custody frames before calling the reader.
// Only the last row may be a still-pending SQLite tail.
fixture_project :: proc(f: ^MarkerFixture,n: int,pending_tail:=false,legacy:=false,check_final:=false,wrong_root:=false) -> r.Result {
	raw,ok := hex.decode(transmute([]u8)string(RealPrefix)); assert(ok)
	defer delete(raw)
	file,decoded := hex.decode(transmute([]u8)string(RealHead)); assert(decoded)
	defer delete(file)
	store: e.StoreId
	copy(store[:],file[6:22])
	published,err := c.decode_head_file(file,store,1); assert(err==.None)
	start,status := c.validate_custody_history(raw,published,store)
	assert(status==.Consistent && start.ordinal==2 && start.committed.checkpoint.sequence==0)
	cp := start.committed.checkpoint
	custody: [dynamic]u8
	defer delete(custody)
	append(&custody,..raw)
	tip,last := start.ordinal,start.record_hash
	rows: [12]r.Row
	p: e.Pledge
	for i in 0..<n {
		seq := e.Sequence(i+1)
		body := f.data[i][:f.lengths[i]]
		assert(endian.put_u64(body[32:40],.Little,u64(seq)))
		copy(f.data[i][len(body):],cp.head[:])
		rows[i] = {{store,1,seq},f.data[i][:len(body)+32]}
		p = {store=store,epoch=1,sequence=seq,previous_sequence=cp.sequence,previous_head=cp.head,digest=fixture_digest(body)}
		p.head = c.derive_head(p)
		for kind in ([?]c.FrameKind{.Pending,.Committed}) {
			if kind==.Committed && pending_tail && i==n-1 { break }
			tip += 1
			frame,encoded := c.encode_record({kind,tip,last,p},store,1); assert(encoded==.None)
			append(&custody,..frame.data[:frame.length])
			copy(last[:],frame.data[frame.length-32:frame.length])
			if kind==.Committed { cp={store,1,seq,p.head}; published={cp,last} }
		}
	}
	view,valid := c.validate_custody_history(custody[:],published,store)
	assert(valid==.Consistent && view.committed.checkpoint==cp && view.ordinal==tip)
	pledge: ^e.Pledge
	if pending_tail { assert(view.pending==p); pledge=&p } else { assert(view.pending==nil) }
	if check_final {
		expected,parsed := hex.decode(transmute([]u8)string(FinalMarkerHead)); defer delete(expected)
		assert(parsed && string(cp.head[:])==string(expected))
	}
	segments := [?]r.Segment{{rows=rows[:n]}}
	receipts := [?]r.Receipt{{epoch=0,digest=fixture_digest(raw[:203],"")}}
	if legacy { return r.project(cp,pledge,segments[:],receipts[:]) }
	if wrong_root { start.committed.checkpoint.head[0] ~= 1 }
	return r.project_markers(start.committed.checkpoint,cp,pledge,segments[:],receipts[:])
}
